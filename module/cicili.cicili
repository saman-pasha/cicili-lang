;;;; cicili-lang -- library(cicili): Prolog with objects and modules, as a
;;;; cocolog module.
;;;;
;;;; WHAT THIS IS. An object is a named scope with slots and methods; a
;;;; method is a clause written inside the object that reads slots by name
;;;; and assigns them with `:='; a child object `extends' a parent and has
;;;; its slots and methods, adding or redefining; an instance is made with
;;;; new/3 and sent a message with `::'. EVERY ONE OF THESE IS CLAUSES IN
;;;; THE STORE: the object as '$object'/2 and '$slot'/3, a method as a clause
;;;; of 'Class::name'/N+1 whose first argument is the instance, an instance
;;;; as '$instance'/2 and one '$value'/3 per slot. So an instance lives as
;;;; long as the store does, across processes -- which is what building on
;;;; cocolog is for.
;;;;
;;;; HOW A PROGRAM REACHES IT. The reader is cocolog's, after two operators
;;;; this module declares. `:- object(Name).' is a directive, and a
;;;; directive is a goal, so it runs as the file is read: it notes the object
;;;; and takes a snapshot of the clauses in the store. The clauses that
;;;; follow -- state/1 and the methods -- are consulted as ordinary clauses.
;;;; `:- end_object.' finds what the file added since the snapshot, turns
;;;; each state/1 into a slot and each other clause into a method under the
;;;; qualified name, with its body rewritten over Self, and retracts the
;;;; originals. Nothing between the directives needs a new reader.
;;;;
;;;; INSIDE A METHOD BODY: a slot's name stands for its value wherever it
;;;; appears as an argument -- except as the KEY of a `Key = Value' pair or
;;;; the left side of `:=', where it is the name (so `new(rect, [w = S], R)'
;;;; inside a method names the slot); `Slot := Expr' evaluates Expr
;;;; (arithmetic when it is arithmetic, unification otherwise) and stores it; a call to a
;;;; method of this object or an ancestor may be written unqualified, as in
;;;; C++; `super::Msg' is the parent's method. A class name used as a
;;;; receiver is a static call, with Self unbound.
;;;;
;;;; THE C SIDE is the module's registration and ccl_version/1 today; the
;;;; language is its Prolog half. The dispatcher and slot access move here
;;;; when they are measured to matter.
;;;;
;;;; THE SURFACE:
;;;;
;;;;   object(+Name)                                  a directive; a scope opens
;;;;   object(+Name, extends(+Parent))                the child of Parent
;;;;   end_object                                     a directive; the scope closes
;;;;   state(Slot = Initial)                          a slot, inside an object
;;;;   Slot := Expr                                   inside a method body
;;;;   super::Message                                 inside a method body
;;;;   module(+Name)  end_module                      a scope for objects: Name::Object
;;;;   new(+Class, +[Slot = Value ...], -Instance)
;;;;   delete(+Instance)
;;;;   Instance::Message                              a message
;;;;   Class::Message                                 a static call, Self unbound
;;;;   instance_of(?Instance, ?Class)                 Class or any ancestor
;;;;   slot(+Instance, ?Slot, ?Value)                 read from outside
;;;;   set_slot(+Instance, +Slot, +Value)             write from outside
;;;;   object_of(+Instance, -Class)
;;;;   extends(?Child, ?Parent)                       the declared parent
;;;;   objects(-Classes)  instances(+Class, -Instances)
;;;;   ccl_version(-Atom)
;;;;   ccl_cocolog_version(-Atom)                     the engine this process runs on
;;;;
;;;; BUILD: sh module/build.sh, with CICILI and COCOLOG naming the two
;;;; checkouts; then COCOLOG_LIBRARY=<this repo>/library and
;;;; `use_module(library(cicili))'.

(DEFPARAMETER *ccl-predicates*
  '(("ccl_version" 1 ccl_p_version)
    ("ccl_cocolog_version" 1 ccl_p_cocolog_version)
    ("ccl_lex_native" 6 ccl_p_lex_native)
    ("ccl_host_arch" 1 ccl_p_host_arch)))

(DEFPARAMETER *ccl-prolog*
  (FORMAT NIL "~{~A ~}"
          (LIST
           ;; ---- the reader: a C file, read whole, into an AST ----------------
           ;; cicili_ast/2 acts like phrase/2 -- the whole file or a syntax error
           ;; naming the line -- and cicili_ast/3 like phrase/3, answering the
           ;; tokens left unparsed. The grammars are library(ccl_syntax).
           ;; library(ccl_include) loads library(ccl_syntax); an #include met while
           ;; parsing is found on the inclusion path and read into the AST too
           ":- use_module(library(ccl_include))."
           ;; the error names the line the unread item begins on, and the farthest
           ;; line the grammar reached inside it -- where it actually gave up
           "cicili_ast(File, AST) :- cicili_ast(File, AST, Rest), ( Rest == [] -> true ; Rest = [tok(_, _, L)|_], ccl_farthest(Far), throw(error(syntax_error(cicili_ast(File, line(L), near(Far))), cicili_ast(File, AST))) )."
           "cicili_ast(File, AST, Rest) :- ccl_read_file(File, AST, Rest)."
           ;; the rest of the compiler: the lowering (library(ccl_ir)), the object
           ;; and the link (library(ccl_build))
           ":- use_module(library(ccl_ir))."
           ":- use_module(library(ccl_build))."
           ":- use_module(library(ccl_driver))."
           "cicili_ir(Units, IR) :- ccl_ir_units(Units, IR)."
           "cicili_compile(IR, File, Flags) :- ccl_compile(IR, File, Flags)."
           "cicili_link(Objects, Flags, Out) :- ccl_link(Objects, Flags, Out)."

           ;; ---- the two operators, and the tables ------------------------
           ":- op(200, xfy, ::)."
           ":- op(990, xfx, :=)."
           ":- dynamic '$object'/2, '$slot'/3, '$instance'/2, '$value'/3."
           ":- dynamic '$ccl_current'/2, '$ccl_module'/1, '$ccl_counter'/1."

           ;; ---- the directives -------------------------------------------
           "object(Name) :- object(Name, extends(none))."
           "object(Name, extends(Parent)) :- '$ccl_qualify'(Name, C), '$ccl_parent'(Parent, P), '$ccl_forget_class'(C), assertz('$object'(C, P)), '$ccl_snapshot'(Snap), retractall('$ccl_current'(_, _)), assertz('$ccl_current'(C, Snap))."
           "end_object :- ( retract('$ccl_current'(C, Snap)) -> true ; throw(error(ccl_error('end_object outside an object'), _)) ), '$ccl_collect'(Snap, Added), '$ccl_define'(C, Added)."
           "module(Name) :- atom(Name), retractall('$ccl_module'(_)), assertz('$ccl_module'(Name))."
           "end_module :- retractall('$ccl_module'(_))."

           ;; a parent is a declared object, by short or full name; none is none
           "'$ccl_parent'(none, none) :- !."
           "'$ccl_parent'(Name, P) :- '$ccl_resolve'(Name, P), !."
           "'$ccl_parent'(Name, _) :- throw(error(existence_error(object, Name), _))."

           ;; names: Module::Name is one atom 'Module::Name'; inside a module a
           ;; short name is qualified by it
           "'$ccl_qualify'(M::N, A) :- !, '$ccl_qualify'(M, MA), atomic_list_concat([MA, '::', N], A)."
           "'$ccl_qualify'(N, A) :- atom(N), ( '$ccl_module'(M) -> atomic_list_concat([M, '::', N], A) ; A = N )."
           "'$ccl_resolve'(M::N, C) :- !, '$ccl_qualify'(M::N, C), '$object'(C, _)."
           "'$ccl_resolve'(N, C) :- atom(N), ( '$ccl_module'(M), atomic_list_concat([M, '::', N], C0), '$object'(C0, _) -> C = C0 ; '$object'(N, _) -> C = N )."

           ;; re-declaring an object replaces it: its slots and methods go first
           "'$ccl_forget_class'(C) :- retractall('$object'(C, _)), retractall('$slot'(C, _, _)), atom_concat(C, '::', Prefix), forall(( current_predicate(F/A), atom(F), atom_concat(Prefix, _, F), functor(H, F, A) ), retractall(H))."

           ;; ---- the snapshot, and what a file added after it ---------------
           "'$ccl_snapshot'(Snap) :- findall(F/A-N, ( current_predicate(F/A), '$ccl_count'(F, A, N) ), Snap)."
           "'$ccl_count'(F, A, N) :- functor(H, F, A), ( catch(findall(x, clause(H, _), Xs), _, fail) -> length(Xs, N) ; N = 0 )."
           "'$ccl_collect'(Snap, Added) :- findall(H-B, ( current_predicate(F/A), \\+ '$ccl_reserved'(F/A), functor(H0, F, A), ( memberchk(F/A-N, Snap) -> true ; N = 0 ), '$ccl_count'(F, A, Now), Now > N, once(catch(findall(H0-B0, clause(H0, B0), All), _, fail)), '$ccl_drop'(N, All, New), member(H-B, New) ), Added)."
           "'$ccl_drop'(0, L, L) :- !."
           "'$ccl_drop'(N, [_|T], L) :- N1 is N - 1, '$ccl_drop'(N1, T, L)."
           "'$ccl_reserved'(object/1). '$ccl_reserved'(object/2). '$ccl_reserved'(end_object/0)."
           "'$ccl_reserved'(module/1). '$ccl_reserved'(end_module/0)."
           "'$ccl_reserved'(F/_) :- atom(F), sub_atom(F, 0, 1, _, '$')."

           ;; ---- defining: slots, then methods over Self ---------------------
           ;; (plain recursion, not forall: in cocolog a throw inside forall/2
           ;; escapes the catch around it, and a bad method must report as a term)
           "'$ccl_define'(C, Added) :- forall(member(state(S = V)-true, Added), assertz('$slot'(C, S, V))), findall(F/A, ( member(H-_, Added), H \\= state(_), functor(H, F, A) ), Ms0), sort(Ms0, Ms), '$ccl_methods'(Added, C, Ms), '$ccl_retract_all'(Added)."
           "'$ccl_methods'([], _, _)."
           "'$ccl_methods'([state(_)-_|T], C, Ms) :- !, '$ccl_methods'(T, C, Ms)."
           "'$ccl_methods'([H-B|T], C, Ms) :- '$ccl_method'(C, Ms, H, B), '$ccl_methods'(T, C, Ms)."
           "'$ccl_retract_all'([])."
           "'$ccl_retract_all'([H-B|T]) :- ( retract((H :- B)) -> true ; true ), functor(H, F, A), ( catch(clause(H, _), _, fail) -> true ; once(catch(abolish(F/A), _, true)) ), '$ccl_retract_all'(T)."
           "'$ccl_method'(C, Ms, H, B) :- H =.. [F|Args], length(Args, A), atomic_list_concat([C, '::', F], QF), Head =.. [QF, Self|Args], '$ccl_slots_of'(C, Slots), '$ccl_body'(C, Self, Slots, Ms, B, Body), assertz((Head :- Body))."

           ;; every slot the class has: its own and its ancestors'
           "'$ccl_slots_of'(C, Slots) :- findall(S, '$ccl_slot_chain'(C, S, _), Ss), sort(Ss, Slots)."
           "'$ccl_slot_chain'(C, S, V) :- '$slot'(C, S, V)."
           "'$ccl_slot_chain'(C, S, V) :- '$object'(C, P), P \\== none, '$ccl_slot_chain'(P, S, V), \\+ '$slot'(C, S, _)."
           "'$ccl_ancestor'(C, C)."
           "'$ccl_ancestor'(C, A) :- '$object'(C, P), P \\== none, '$ccl_ancestor'(P, A)."

           ;; ---- the body rewrite --------------------------------------------
           "'$ccl_body'(_, _, _, _, V, call(V)) :- var(V), !."
           "'$ccl_body'(C, S, Sl, Ms, (A, B), (A1, B1)) :- !, '$ccl_body'(C, S, Sl, Ms, A, A1), '$ccl_body'(C, S, Sl, Ms, B, B1)."
           "'$ccl_body'(C, S, Sl, Ms, (A ; B), (A1 ; B1)) :- !, '$ccl_body'(C, S, Sl, Ms, A, A1), '$ccl_body'(C, S, Sl, Ms, B, B1)."
           "'$ccl_body'(C, S, Sl, Ms, (A -> B), (A1 -> B1)) :- !, '$ccl_body'(C, S, Sl, Ms, A, A1), '$ccl_body'(C, S, Sl, Ms, B, B1)."
           "'$ccl_body'(C, S, Sl, Ms, (A *-> B), (A1 *-> B1)) :- !, '$ccl_body'(C, S, Sl, Ms, A, A1), '$ccl_body'(C, S, Sl, Ms, B, B1)."
           "'$ccl_body'(C, S, Sl, Ms, \\+ A, \\+ A1) :- !, '$ccl_body'(C, S, Sl, Ms, A, A1)."
           "'$ccl_body'(C, S, Sl, Ms, once(A), once(A1)) :- !, '$ccl_body'(C, S, Sl, Ms, A, A1)."
           "'$ccl_body'(C, S, Sl, Ms, ignore(A), ignore(A1)) :- !, '$ccl_body'(C, S, Sl, Ms, A, A1)."
           "'$ccl_body'(C, S, Sl, Ms, forall(A, B), forall(A1, B1)) :- !, '$ccl_body'(C, S, Sl, Ms, A, A1), '$ccl_body'(C, S, Sl, Ms, B, B1)."
           "'$ccl_body'(C, S, Sl, Ms, findall(T, G, L), findall(T, G1, L)) :- !, '$ccl_body'(C, S, Sl, Ms, G, G1)."
           "'$ccl_body'(C, S, Sl, Ms, catch(G, E, R), catch(G1, E, R1)) :- !, '$ccl_body'(C, S, Sl, Ms, G, G1), '$ccl_body'(C, S, Sl, Ms, R, R1)."
           ;; Slot := Expr
           "'$ccl_body'(C, S, Sl, _, Slot := Expr, Goal) :- !, ( memberchk(Slot, Sl) -> true ; throw(error(existence_error(slot, C::Slot), _)) ), '$ccl_reads'(S, Sl, Expr, Expr1, Reads), '$ccl_conj'(Reads, ('$ccl_assign'(Expr1, V), '$ccl_set'(S, Slot, V)), Goal)."
           ;; super::Msg -- the parent's method, from the class the method belongs to
           "'$ccl_body'(C, S, Sl, _, super::Msg, Goal) :- !, '$ccl_reads'(S, Sl, Msg, Msg1, Reads), '$ccl_conj'(Reads, '$ccl_super'(C, S, Msg1), Goal)."
           ;; inside a module, a sibling object named short in new/3, a static
           ;; call, instances/2 or instance_of/2 is qualified now, while the
           ;; module is current -- at run time nothing says which module the
           ;; method came from
           "'$ccl_body'(C, S, Sl, Ms, new(N, I, R), Goal) :- '$ccl_sibling'(N, N1), !, '$ccl_body'(C, S, Sl, Ms, '$ccl_new'(N1, I, R), Goal)."
           "'$ccl_body'(C, S, Sl, Ms, N::Msg, Goal) :- '$ccl_sibling'(N, N1), !, '$ccl_body'(C, S, Sl, Ms, '$ccl_static'(N1, Msg), Goal)."
           "'$ccl_body'(C, S, Sl, Ms, instances(N, Is), Goal) :- '$ccl_sibling'(N, N1), !, '$ccl_body'(C, S, Sl, Ms, '$ccl_instances'(N1, Is), Goal)."
           "'$ccl_body'(C, S, Sl, Ms, instance_of(I, N), Goal) :- '$ccl_sibling'(N, N1), !, '$ccl_body'(C, S, Sl, Ms, '$ccl_instance_of'(I, N1), Goal)."
           "'$ccl_sibling'(N, N1) :- atom(N), '$ccl_module'(M), atomic_list_concat([M, '::', N], N1), '$object'(N1, _)."
           "'$ccl_new'(N, I, R) :- new(N, I, R)."
           "'$ccl_static'(N, Msg) :- N::Msg."
           "'$ccl_instances'(N, Is) :- instances(N, Is)."
           "'$ccl_instance_of'(I, N) :- instance_of(I, N)."
           ;; an unqualified call to a method of this object or an ancestor is Self::G
           "'$ccl_body'(C, S, Sl, Ms, G, Goal) :- functor(G, F, A), ( memberchk(F/A, Ms) ; '$ccl_ancestor'(C, An), An \\== C, atomic_list_concat([An, '::', F], QF), A1 is A + 1, current_predicate(QF/A1) ), !, '$ccl_reads'(S, Sl, G, G1, Reads), '$ccl_conj'(Reads, '$ccl_self'(C, S, G1), Goal)."
           ;; an own-method call: on the instance when there is one (its class
           ;; decides, so a child's redefinition wins), on the class in a static call
           "'$ccl_self'(C, S, Msg) :- ( var(S) -> '$ccl_send'(C, S, Msg) ; S::Msg )."
           ;; any other goal: slot names among its arguments are reads
           "'$ccl_body'(_, S, Sl, _, G, Goal) :- '$ccl_reads'(S, Sl, G, G1, Reads), '$ccl_conj'(Reads, G1, Goal)."

           ;; replace each slot name in the arguments of a term by a fresh
           ;; variable, and answer the reads that bind them
           "'$ccl_reads'(S, Sl, T, T1, Reads) :- T =.. [F|Args], '$ccl_reads_list'(S, Sl, Args, Args1, Reads), T1 =.. [F|Args1]."
           "'$ccl_reads_list'(_, _, [], [], [])."
           "'$ccl_reads_list'(S, Sl, [A|As], [A1|As1], Reads) :- '$ccl_read_arg'(S, Sl, A, A1, R), '$ccl_reads_list'(S, Sl, As, As1, Rs), append(R, Rs, Reads)."
           "'$ccl_read_arg'(_, _, V, V, []) :- var(V), !."
           ;; the key of a Key = Value pair is a name, not a read: new/3's initial
           ;; values, and any key-value list, are written with slot names as keys
           "'$ccl_read_arg'(S, Sl, K = V, K = V1, Reads) :- atom(K), !, '$ccl_read_arg'(S, Sl, V, V1, Reads)."
           "'$ccl_read_arg'(S, Sl, A, V, ['$ccl_get'(S, A, V)]) :- atom(A), memberchk(A, Sl), !."
           "'$ccl_read_arg'(S, Sl, T, T1, Reads) :- compound(T), !, T =.. [F|Args], '$ccl_reads_list'(S, Sl, Args, Args1, Reads), T1 =.. [F|Args1]."
           "'$ccl_read_arg'(_, _, T, T, [])."
           "'$ccl_conj'([], G, G) :- !."
           "'$ccl_conj'([R|Rs], G, (R, G1)) :- '$ccl_conj'(Rs, G, G1)."

           ;; ---- running: slots, assignment, dispatch --------------------------
           "'$ccl_get'(S, _, _) :- var(S), !, throw(error(ccl_error('a slot read needs an instance: this is a static call'), _))."
           "'$ccl_get'(S, Slot, V) :- ( '$value'(S, Slot, V0) -> V = V0 ; throw(error(existence_error(slot, S::Slot), _)) )."
           "'$ccl_set'(S, _, _) :- var(S), !, throw(error(ccl_error('a slot assignment needs an instance: this is a static call'), _))."
           "'$ccl_set'(S, Slot, V) :- retractall('$value'(S, Slot, _)), assertz('$value'(S, Slot, V))."
           "'$ccl_assign'(E, V) :- ( '$ccl_arith'(E) -> V is E ; V = E )."
           "'$ccl_arith'(E) :- number(E), !."
           "'$ccl_arith'(E) :- compound(E), functor(E, F, A), memberchk(F/A, [(+)/2, (-)/2, (*)/2, (/)/2, (//)/2, mod/2, rem/2, (**)/2, (^)/2, (-)/1, abs/1, sign/1, min/2, max/2, sqrt/1, sin/1, cos/1, tan/1, exp/1, log/1, float/1, integer/1, truncate/1, round/1, ceiling/1, floor/1, (>>)/2, (<<)/2, (/\\\\)/2, (\\\\/)/2, xor/2, msb/1, gcd/2]), !."
           "'$ccl_arith'(E) :- atom(E), memberchk(E, [pi, e, inf, nan, epsilon, max_tagged_integer, random])."

           "Recv::Msg :- var(Recv), !, throw(error(instantiation_error, Recv::Msg))."
           "Recv::Msg :- var(Msg), !, throw(error(instantiation_error, Recv::Msg))."
           "Recv::Msg :- '$instance'(Recv, C), !, '$ccl_send'(C, Recv, Msg)."
           "Recv::Msg :- '$ccl_resolve'(Recv, C), !, '$ccl_send'(C, _, Msg)."
           ;; :: is xfy, so Module::Object::Msg reads as Module::(Object::Msg):
           ;; when the receiver is no object but Module::Object is, that is the call
           "Recv::(Inner::Msg) :- atom(Recv), '$ccl_resolve'(Recv::Inner, C), !, '$ccl_send'(C, _, Msg)."
           "Recv::Msg :- throw(error(existence_error(object, Recv), Recv::Msg))."
           "'$ccl_send'(C, Self, Msg) :- Msg =.. [F|Args], length(Args, A), ( '$ccl_find'(C, F, A, QF) -> G =.. [QF, Self|Args], call(G) ; A1 is A + 1, throw(error(existence_error(method, C::F/A1), _)) )."
           "'$ccl_find'(C, F, A, QF) :- atomic_list_concat([C, '::', F], QF0), A1 is A + 1, ( current_predicate(QF0/A1) -> QF = QF0 ; '$object'(C, P), P \\== none, '$ccl_find'(P, F, A, QF) )."
           "'$ccl_super'(C, Self, Msg) :- ( '$object'(C, P), P \\== none -> '$ccl_send'(P, Self, Msg) ; throw(error(existence_error(parent, C), super::Msg)) )."

           ;; ---- instances --------------------------------------------------
           ;; the initial values are checked BEFORE the instance exists, so a
           ;; refused new/3 leaves nothing behind (and no throw sits inside a forall)
           "new(Class, Inits, Inst) :- ( '$ccl_resolve'(Class, C) -> true ; throw(error(existence_error(object, Class), new(Class, Inits, Inst))) ), ( is_list(Inits) -> true ; throw(error(type_error(list, Inits), new(Class, Inits, Inst))) ), '$ccl_slots_of'(C, Slots), '$ccl_check_inits'(Inits, C, Slots), '$ccl_next'(N), atomic_list_concat([C, '#', N], Inst), assertz('$instance'(Inst, C)), forall('$ccl_slot_chain'(C, S, V), assertz('$value'(Inst, S, V))), '$ccl_inits'(Inits, Inst)."
           "'$ccl_check_inits'([], _, _)."
           "'$ccl_check_inits'([S = _|T], C, Slots) :- !, ( memberchk(S, Slots) -> true ; throw(error(existence_error(slot, C::S), new)) ), '$ccl_check_inits'(T, C, Slots)."
           "'$ccl_check_inits'([Init|_], _, _) :- throw(error(type_error(slot_assignment, Init), new))."
           "'$ccl_inits'([], _)."
           "'$ccl_inits'([S = V|T], Inst) :- '$ccl_set'(Inst, S, V), '$ccl_inits'(T, Inst)."
           "'$ccl_next'(N) :- ( retract('$ccl_counter'(N0)) -> N is N0 + 1 ; N = 1 ), assertz('$ccl_counter'(N))."
           "delete(Inst) :- ( retract('$instance'(Inst, _)) -> retractall('$value'(Inst, _, _)) ; throw(error(existence_error(instance, Inst), delete(Inst))) )."
           "object_of(Inst, C) :- '$instance'(Inst, C)."
           "instance_of(Inst, Class) :- '$instance'(Inst, C0), '$ccl_ancestor'(C0, C), ( var(Class) -> Class = C ; '$ccl_resolve'(Class, C) )."
           "slot(Inst, S, V) :- ( '$instance'(Inst, _) -> true ; throw(error(existence_error(instance, Inst), slot(Inst, S, V))) ), '$value'(Inst, S, V)."
           "set_slot(Inst, S, V) :- ( '$value'(Inst, S, _) -> '$ccl_set'(Inst, S, V) ; throw(error(existence_error(slot, Inst::S), set_slot(Inst, S, V))) )."
           "extends(Child, Parent) :- '$object'(Child, Parent), Parent \\== none."
           "objects(Cs) :- findall(C, '$object'(C, _), Cs0), sort(Cs0, Cs)."
           "instances(Class, Is) :- '$ccl_resolve'(Class, C), findall(I, ( '$instance'(I, C0), '$ccl_ancestor'(C0, C) ), Is)."
           )))

(source "cicili.c"
  (make :std #t :compile #f)

  (import "./sdk.cicili")
  (coco-sdk)

  ;; ccl_version(-Atom): THE VERSION. Every commit raises it (owner's rule),
  ;; one number per change; `cicili --version' prints it with LLVM's.
  (func ccl_p_version ((coco_engine * e) (size_t g)) (out int)
        (return (coco_m_unify_atom e (coco_m_arg e g 0) "0.23")))

  ;; ccl_cocolog_version(-Atom): the engine's own version text, from the
  ;; running binary (coco_version_text is cocolog's, resolved at load like
  ;; the SDK's coco_m_* are), so `cicili --version' names what it runs on.
  (decl) (func coco_version_text () (out const char *))
  (func ccl_p_cocolog_version ((coco_engine * e) (size_t g)) (out int)
        (return (coco_m_unify_atom e (coco_m_arg e g 0) (coco_version_text))))


  ;; ---- the lexer, native --------------------------------------------------
  ;; ccl_lex_native(+Text, +Line0, +Mode, +Lang, -Tokens, -Rest): the reader's
  ;; lexer, ccl_lex//2 of library/ccl_syntax.pl, token for token -- the DCG
  ;; stays as the specification and the fallback, and test/reader.pl compares
  ;; the two on every fixture. Text is an atom (a whole file, or one line of
  ;; the preprocessor's), Line0 the line it starts on, Mode `line' or `punct'
  ;; (the value of '$ccl_hash': in punct mode `#' and `##' are punctuators and
  ;; a number keeps its spelling, tok(num, Codes, L)), Lang `c' or `cpp' (the
  ;; keywords, and `::'). Tokens is the list of tok(Kind, Value, Line); Rest
  ;; the codes left where lexing stopped, [] when it read everything. The DCG
  ;; ran at 0.15 ms a token, the floor of every read; this is C.
  ;; coco_make is the engine's, behind coco_m_machine: a compound from an
  ;; array of argument terms.
  (decl) (func coco_make ((coco_machine * m) (const char * name) (u32 n) (const size_t * args)) (out size_t))

  (struct ccl_lx
    (member coco_engine * e) (member coco_machine * m)
    (member const char * s) (member size_t n) (member size_t i) (member i64 line)
    (member int punct) (member int cpp)
    (member size_t * toks) (member size_t ntoks) (member size_t cap)
    (member char * buf) (member size_t bn) (member size_t bcap)
    (member size_t k_id) (member size_t k_kw) (member size_t k_int) (member size_t k_float) (member size_t k_str)
    (member size_t k_chr) (member size_t k_p) (member size_t k_pp) (member size_t k_cocolog) (member size_t k_num))

  ;; the code at i, -1 past the end
  (static) (func ccl_lx_at ((ccl_lx * x) (size_t i)) (out int)
        (if (>= i (-> x n)) (return -1))
        (return (cast int (cast u8 (nth i (-> x s))))))
  (static) (func ccl_lx_digit ((int c)) (out int) (return (and (>= c 48) (<= c 57))))
  (static) (func ccl_lx_hex ((int c)) (out int)
        (return (or (ccl_lx_digit c) (or (and (>= c 97) (<= c 102)) (and (>= c 65) (<= c 70))))))
  (static) (func ccl_lx_hexval ((int c)) (out int)
        (if (ccl_lx_digit c) (return (- c 48)))
        (if (>= c 97) (return (+ (- c 97) 10)))
        (return (+ (- c 65) 10)))
  (static) (func ccl_lx_alpha ((int c)) (out int)
        (return (or (and (>= c 97) (<= c 122)) (or (and (>= c 65) (<= c 90)) (== c 95)))))
  (static) (func ccl_lx_alnum ((int c)) (out int) (return (or (ccl_lx_alpha c) (ccl_lx_digit c))))
  (static) (func ccl_lx_trimc ((int c)) (out int) (return (or (== c 32) (or (== c 9) (== c 13)))))

  ;; the tokens collected, then the text buffer
  (static) (func ccl_lx_push ((ccl_lx * x) (size_t t))
        (if (>= (-> x ntoks) (-> x cap))
            (block (set (-> x cap) (* (-> x cap) 2))
                   (set (-> x toks) (cast (size_t *) (realloc (-> x toks) (* (-> x cap) (sizeof size_t)))))))
        (set (nth (-> x ntoks) (-> x toks)) t)
        (set (-> x ntoks) (+ (-> x ntoks) 1)))
  (static) (func ccl_lx_tok ((ccl_lx * x) (size_t k) (size_t v) (i64 line))
        (let ((size_t args [3]))
          (set (nth 0 args) k)
          (set (nth 1 args) v)
          (set (nth 2 args) (coco_m_new_int (-> x e) line))
          (ccl_lx_push x (coco_make (-> x m) "tok" 3 args))))
  (static) (func ccl_lx_putc ((ccl_lx * x) (int c))
        (if (>= (+ (-> x bn) 2) (-> x bcap))
            (block (set (-> x bcap) (* (-> x bcap) 2))
                   (set (-> x buf) (cast (char *) (realloc (-> x buf) (-> x bcap))))))
        (set (nth (-> x bn) (-> x buf)) (cast char c))
        (set (-> x bn) (+ (-> x bn) 1))
        (set (nth (-> x bn) (-> x buf)) 0))
  (static) (func ccl_lx_puts ((ccl_lx * x) (size_t from) (size_t to))
        (let ((size_t k . 0))
          (set k from)
          (while (< k to) (ccl_lx_putc x (ccl_lx_at x k)) (set k (+ k 1)))))
  ;; a code list from n bytes
  (static) (func ccl_lx_codes ((ccl_lx * x) (const char * p) (size_t n)) (out size_t)
        (let ((size_t * items . #'(cast (size_t *) (malloc (* (+ n 1) (sizeof size_t))))) (size_t lst . 0) (size_t k . 0))
          (while (< k n)
            (set (nth k items) (coco_m_new_int (-> x e) (cast i64 (cast u8 (nth k p)))))
            (set k (+ k 1)))
          (set lst (coco_m_list (-> x e) items n))
          (free items)
          (return lst)))

  ;; layout: blanks, newlines (counted), and both kinds of comment
  (static) (func ccl_lx_layout ((ccl_lx * x))
        (let ((int c . 0))
          (while (< (-> x i) (-> x n))
            (set c (ccl_lx_at x (-> x i)))
            (cond
              ((== c 10) (set (-> x line) (+ (-> x line) 1)) (set (-> x i) (+ (-> x i) 1)))
              ((or (== c 32) (or (== c 9) (or (== c 13) (or (== c 12) (== c 11))))) (set (-> x i) (+ (-> x i) 1)))
              ((and (== c 47) (== (ccl_lx_at x (+ (-> x i) 1)) 47))
               (set (-> x i) (+ (-> x i) 2))
               (while (and (< (-> x i) (-> x n)) (!= (ccl_lx_at x (-> x i)) 10)) (set (-> x i) (+ (-> x i) 1))))
              ((and (== c 47) (== (ccl_lx_at x (+ (-> x i) 1)) 42))
               (set (-> x i) (+ (-> x i) 2))
               (while (< (-> x i) (-> x n))
                 (if (and (== (ccl_lx_at x (-> x i)) 42) (== (ccl_lx_at x (+ (-> x i) 1)) 47))
                     (block (set (-> x i) (+ (-> x i) 2)) break))
                 (if (== (ccl_lx_at x (-> x i)) 10) (set (-> x line) (+ (-> x line) 1)))
                 (set (-> x i) (+ (-> x i) 1))))
              (#t (return))))))

  ;; after a backslash: the code it means and j past it; -1 when it is none (\x with no digit, the end)
  (static) (func ccl_lx_escape ((ccl_lx * x) (size_t * j)) (out int)
        (let ((int c . 0) (int v . 0) (int k . 0))
          (set c (ccl_lx_at x (cof j)))
          (if (< c 0) (return -1))
          (set (cof j) (+ (cof j) 1))
          (cond
            ((== c 110) (return 10)) ((== c 116) (return 9)) ((== c 114) (return 13)) ((== c 48) (return 0))
            ((== c 97) (return 7)) ((== c 98) (return 8)) ((== c 102) (return 12)) ((== c 118) (return 11))
            ((== c 101) (return 27))
            ((== c 120)
             (while (ccl_lx_hex (ccl_lx_at x (cof j)))
               (set v (+ (* v 16) (ccl_lx_hexval (ccl_lx_at x (cof j)))))
               (set (cof j) (+ (cof j) 1))
               (set k (+ k 1)))
             (if (== k 0) (return -1))
             (return v))
            (#t (return c)))))

  ;; "..." : its codes with the escapes resolved; 0 when it never closes
  (static) (func ccl_lx_string ((ccl_lx * x) (i64 line)) (out int)
        (let ((size_t j . 0) (int c . 0) (int v . 0))
          (set j (+ (-> x i) 1))
          (set (-> x bn) 0)
          (while 1
            (set c (ccl_lx_at x j))
            (if (< c 0) (return 0))
            (if (== c 34) (block (set j (+ j 1)) break))
            (if (== c 92)
                (block (set j (+ j 1))
                       (set v (ccl_lx_escape x (aof j)))
                       (if (< v 0) (return 0))
                       (ccl_lx_putc x v))
                (block (ccl_lx_putc x c) (set j (+ j 1)))))
          (ccl_lx_tok x (-> x k_str) (ccl_lx_codes x (-> x buf) (-> x bn)) line)
          (set (-> x i) j)
          (return 1)))
  ;; 'c' : one code, escaped or not
  (static) (func ccl_lx_char ((ccl_lx * x) (i64 line)) (out int)
        (let ((size_t j . 0) (int c . 0) (int v . 0))
          (set j (+ (-> x i) 1))
          (set c (ccl_lx_at x j))
          (if (< c 0) (return 0))
          (if (== c 92)
              (block (set j (+ j 1)) (set v (ccl_lx_escape x (aof j))) (if (< v 0) (return 0)))
              (block (set v c) (set j (+ j 1))))
          (if (!= (ccl_lx_at x j) 39) (return 0))
          (ccl_lx_tok x (-> x k_chr) (coco_m_new_int (-> x e) (cast i64 v)) line)
          (set (-> x i) (+ j 1))
          (return 1)))

  ;; numbers, as ccl_number//2 has them: 0x hex; digits [. digits] [e [+-] digits]
  ;; a float (spelled again for strtod, `1.' as 1.0, `1e5' as 1.0e5); a leading 0
  ;; over octal digits an octal; else decimal. The suffixes [uUlL]* and [fFlL].
  ;; An `e' that no digit follows FAILS the float (the DCG's cut), and the
  ;; number reads as an int up to the dot.
  (static) (func ccl_lx_int_suffix ((ccl_lx * x) (size_t j)) (out size_t)
        (let ((int c . 0))
          (while 1
            (set c (ccl_lx_at x j))
            (if (or (== c 117) (or (== c 85) (or (== c 108) (== c 76)))) (set j (+ j 1)) break))
          (return j)))
  (static) (func ccl_lx_float_suffix ((ccl_lx * x) (size_t j)) (out size_t)
        (let ((int c . 0))
          (set c (ccl_lx_at x j))
          (if (or (== c 102) (or (== c 70) (or (== c 108) (== c 76)))) (return (+ j 1)))
          (return j)))
  ;; the exponent at j: j when there is none, 0 when an e has no digits, else the index past it (spelled into the buffer)
  (static) (func ccl_lx_exponent ((ccl_lx * x) (size_t j)) (out size_t)
        (let ((int c . 0) (size_t k . 0) (int sign . 0))
          (set c (ccl_lx_at x j))
          (if (not (or (== c 101) (== c 69))) (return j))
          (set k (+ j 1))
          (set c (ccl_lx_at x k))
          (if (or (== c 45) (== c 43)) (block (set sign c) (set k (+ k 1))))
          (if (not (ccl_lx_digit (ccl_lx_at x k))) (return 0))
          (ccl_lx_putc x 101)
          (if sign (ccl_lx_putc x sign))
          (while (ccl_lx_digit (ccl_lx_at x k)) (ccl_lx_putc x (ccl_lx_at x k)) (set k (+ k 1)))
          (return k)))
  (static) (func ccl_lx_emit_int ((ccl_lx * x) (u64 v) (size_t j) (i64 line))
        (ccl_lx_tok x (-> x k_int) (coco_m_new_int (-> x e) (cast i64 v)) line)
        (set (-> x i) j))
  (static) (func ccl_lx_emit_float ((ccl_lx * x) (size_t j) (i64 line))
        (let ((char * endp . nil))
          (ccl_lx_tok x (-> x k_float) (coco_m_new_float (-> x e) (strtod (-> x buf) (aof endp))) line)
          (set (-> x i) j)))
  (static) (func ccl_lx_number ((ccl_lx * x) (i64 line)) (out int)
        (let ((size_t i0 . 0) (size_t j . 0) (size_t dend . 0) (size_t fstart . 0) (size_t fend . 0) (size_t k . 0) (size_t q . 0)
              (int c . 0) (int allocts . 1) (u64 v . 0))
          (set i0 (-> x i))
          (set j i0)
          (set c (ccl_lx_at x (+ j 1)))
          (if (and (== (ccl_lx_at x j) 48) (or (== c 120) (== c 88)))
              (block
                (set j (+ j 2))
                (while (ccl_lx_hex (ccl_lx_at x j))
                  (set v (+ (* v 16) (cast u64 (ccl_lx_hexval (ccl_lx_at x j)))))
                  (set j (+ j 1))
                  (set k (+ k 1)))
                (if (== k 0) (return 0))
                (ccl_lx_emit_int x v (ccl_lx_int_suffix x j) line)
                (return 1)))
          (while (ccl_lx_digit (ccl_lx_at x j)) (set j (+ j 1)))
          (set dend j)
          (if (== (ccl_lx_at x j) 46)
              (block
                (set j (+ j 1))
                (set fstart j)
                (while (ccl_lx_digit (ccl_lx_at x j)) (set j (+ j 1)))
                (set fend j)
                (set (-> x bn) 0)
                (ccl_lx_puts x i0 dend)
                (ccl_lx_putc x 46)
                (if (== fstart fend) (ccl_lx_putc x 48) (ccl_lx_puts x fstart fend))
                (set k (ccl_lx_exponent x j))
                (if (!= k 0)
                    (block (ccl_lx_emit_float x (ccl_lx_float_suffix x k) line) (return 1))))
              (block
                (set (-> x bn) 0)
                (ccl_lx_puts x i0 dend)
                (ccl_lx_putc x 46)
                (ccl_lx_putc x 48)
                (set k (ccl_lx_exponent x j))
                (if (and (!= k 0) (!= k j))
                    (block (ccl_lx_emit_float x (ccl_lx_float_suffix x k) line) (return 1)))))
          ;; an int: octal when a 0 leads more digits, all of them octal
          (if (and (== (ccl_lx_at x i0) 48) (> dend (+ i0 1)))
              (block
                (set q i0)
                (while (< q dend) (if (> (ccl_lx_at x q) 55) (set allocts 0)) (set q (+ q 1)))
                (if allocts
                    (block
                      (set v 0)
                      (set q i0)
                      (while (< q dend) (set v (+ (* v 8) (cast u64 (- (ccl_lx_at x q) 48)))) (set q (+ q 1)))
                      (ccl_lx_emit_int x v (ccl_lx_int_suffix x dend) line)
                      (return 1)))))
          (set v 0)
          (set q i0)
          (while (< q dend) (set v (+ (* v 10) (cast u64 (- (ccl_lx_at x q) 48)))) (set q (+ q 1)))
          (ccl_lx_emit_int x v (ccl_lx_int_suffix x dend) line)
          (return 1)))
  ;; a pp-number, in the preprocessor's mode: digits, letters, dots, a sign after an exponent letter; as spelled
  (static) (func ccl_lx_pp_number ((ccl_lx * x) (i64 line))
        (let ((size_t j . 0) (int c . 0) (int d . 0))
          (set j (+ (-> x i) 1))
          (while 1
            (set c (ccl_lx_at x j))
            (set d (ccl_lx_at x (+ j 1)))
            (cond
              ((and (or (== c 101) (or (== c 69) (or (== c 112) (== c 80)))) (or (== d 43) (== d 45))) (set j (+ j 2)))
              ((or (ccl_lx_alnum c) (== c 46)) (set j (+ j 1)))
              (#t break)))
          (ccl_lx_tok x (-> x k_num) (ccl_lx_codes x (+ (-> x s) (-> x i)) (- j (-> x i))) line)
          (set (-> x i) j)))

  ;; words: C's keywords, and C++'s in cpp
  (static) (var const char * ccl_lx_ckw [48] . '{ "auto" "break" "case" "char" "const" "continue" "default" "do" "double" "else"
    "enum" "extern" "float" "for" "goto" "if" "inline" "int" "long" "register" "restrict" "return" "short"
    "signed" "sizeof" "static" "struct" "switch" "typedef" "union" "unsigned" "void" "volatile" "while"
    "_Bool" "_Complex" "_Noreturn" "_Atomic" "_Static_assert" "_Thread_local" "_Float16" nil })
  (static) (var const char * ccl_lx_cppkw [48] . '{ "bool" "class" "namespace" "template" "typename" "this" "new" "delete" "operator" "using"
    "public" "private" "protected" "virtual" "friend" "true" "false" "nullptr" "try" "catch" "throw" "static_cast" "dynamic_cast"
    "reinterpret_cast" "const_cast" "explicit" "mutable" "constexpr" "noexcept" "decltype" "typeid" "wchar_t" "char16_t" "char32_t"
    "thread_local" "alignas" "alignof" "static_assert" nil })
  (static) (func ccl_lx_in ((const char ** table) (const char * w)) (out int)
        (let ((size_t k . 0))
          (while (!= (nth k table) nil)
            (if (== 0 (strcmp (nth k table) w)) (return 1))
            (set k (+ k 1)))
          (return 0)))
  (static) (func ccl_lx_word ((ccl_lx * x) (i64 line))
        (let ((size_t j . 0) (int kw . 0))
          (set j (-> x i))
          (while (ccl_lx_alnum (ccl_lx_at x j)) (set j (+ j 1)))
          (set (-> x bn) 0)
          (ccl_lx_puts x (-> x i) j)
          (set kw (ccl_lx_in ccl_lx_ckw (-> x buf)))
          (if (and (not kw) (-> x cpp)) (set kw (ccl_lx_in ccl_lx_cppkw (-> x buf))))
          (ccl_lx_tok x (? kw (-> x k_kw) (-> x k_id)) (coco_m_new_atom (-> x e) (-> x buf)) line)
          (set (-> x i) j)))

  ;; punctuators, longest first, as ccl_punct//1 tries them; `::' in C++ only
  (static) (var const char * ccl_lx_p3 [8] . '{ "..." ">>=" "<<=" "<*>" nil })
  (static) (var const char * ccl_lx_p2 [24] . '{ ":=" "->" "++" "--" "<<" ">>" "<=" ">=" "==" "!=" "&&" "||" "*=" "/=" "%=" "+=" "-=" "&=" "^=" "|=" nil })
  (static) (var const char * ccl_lx_p1 . "[](){}.&*+-~!/%<>^|?:;=,")
  (static) (func ccl_lx_punct ((ccl_lx * x) (i64 line)) (out int)
        (let ((size_t k . 0) (int c . 0) (const char * p . nil) (char one [2]))
          (set p (+ (-> x s) (-> x i)))
          (while (!= (nth k ccl_lx_p3) nil)
            (if (== 0 (strncmp p (nth k ccl_lx_p3) 3))
                (block (ccl_lx_tok x (-> x k_p) (coco_m_new_atom (-> x e) (nth k ccl_lx_p3)) line)
                       (set (-> x i) (+ (-> x i) 3))
                       (return 1)))
            (set k (+ k 1)))
          (if (and (-> x cpp) (== 0 (strncmp p "::" 2)))
              (block (ccl_lx_tok x (-> x k_p) (coco_m_new_atom (-> x e) "::") line)
                     (set (-> x i) (+ (-> x i) 2))
                     (return 1)))
          (set k 0)
          (while (!= (nth k ccl_lx_p2) nil)
            (if (== 0 (strncmp p (nth k ccl_lx_p2) 2))
                (block (ccl_lx_tok x (-> x k_p) (coco_m_new_atom (-> x e) (nth k ccl_lx_p2)) line)
                       (set (-> x i) (+ (-> x i) 2))
                       (return 1)))
            (set k (+ k 1)))
          (set c (ccl_lx_at x (-> x i)))
          (set k 0)
          (while (!= (cast int (cast u8 (nth k ccl_lx_p1))) 0)
            (if (== (cast int (cast u8 (nth k ccl_lx_p1))) c)
                (block (set (nth 0 one) (cast char c))
                       (set (nth 1 one) 0)
                       (ccl_lx_tok x (-> x k_p) (coco_m_new_atom (-> x e) one) line)
                       (set (-> x i) (+ (-> x i) 1))
                       (return 1)))
            (set k (+ k 1)))
          (return 0)))

  ;; #cocolog ... #end: the lines between, raw, to the #end line or the file's end
  (static) (func ccl_lx_cocolog ((ccl_lx * x) (i64 line))
        (let ((size_t j . 0) (size_t ls . 0) (size_t le . 0) (size_t ts . 0) (size_t te . 0) (int c . 0) (int nl . 0))
          (set j (-> x i))
          (set (-> x bn) 0)
          (while 1
            (set ls j)
            (set nl 0)
            (while 1
              (set c (ccl_lx_at x j))
              (if (< c 0) break)
              (set j (+ j 1))
              (if (== c 10) (block (set nl 1) break)))
            (set le (? nl (- j 1) j))
            (if nl (set (-> x line) (+ (-> x line) 1)))
            (set ts ls)
            (set te le)
            (while (and (< ts te) (ccl_lx_trimc (ccl_lx_at x ts))) (set ts (+ ts 1)))
            (while (and (> te ts) (ccl_lx_trimc (ccl_lx_at x (- te 1)))) (set te (- te 1)))
            (if (and (== (- te ts) 4) (== 0 (strncmp (+ (-> x s) ts) "#end" 4))) break)
            (ccl_lx_puts x ls le)
            (if nl (ccl_lx_putc x 10))
            (if (not nl) break))
          (ccl_lx_tok x (-> x k_cocolog) (coco_m_new_atom (-> x e) (-> x buf)) line)
          (set (-> x i) j)))
  ;; a `#' line: its text to the end of the line, continuations joined; `#cocolog' opens a block
  (static) (func ccl_lx_hash ((ccl_lx * x) (i64 line))
        (let ((size_t j . 0) (int c . 0) (size_t start . 0) (size_t end . 0))
          (set j (+ (-> x i) 1))
          (set (-> x bn) 0)
          (ccl_lx_putc x 35)
          (while 1
            (set c (ccl_lx_at x j))
            (if (< c 0) break)
            (if (== c 10) (block (set j (+ j 1)) (set (-> x line) (+ (-> x line) 1)) break))
            (if (and (== c 92) (== (ccl_lx_at x (+ j 1)) 10))
                (block (set j (+ j 2)) (set (-> x line) (+ (-> x line) 1)) continue))
            (ccl_lx_putc x c)
            (set j (+ j 1)))
          (set start 1)
          (set end (-> x bn))
          (while (and (< start end) (ccl_lx_trimc (cast int (cast u8 (nth start (-> x buf)))))) (set start (+ start 1)))
          (while (and (> end start) (ccl_lx_trimc (cast int (cast u8 (nth (- end 1) (-> x buf)))))) (set end (- end 1)))
          (if (and (== (- end start) 7) (== 0 (strncmp (+ (-> x buf) start) "cocolog" 7)))
              (block (set (-> x i) j) (ccl_lx_cocolog x line) (return)))
          (ccl_lx_tok x (-> x k_pp) (coco_m_new_atom (-> x e) (-> x buf)) line)
          (set (-> x i) j)))

  ;; one token at i, as ccl_token//3 tries its clauses; 0 where none reads
  (static) (func ccl_lx_token ((ccl_lx * x)) (out int)
        (let ((int c . 0) (i64 line . 0))
          (set c (ccl_lx_at x (-> x i)))
          (set line (-> x line))
          (cond
            ((and (-> x punct) (== c 35))
             (if (== (ccl_lx_at x (+ (-> x i) 1)) 35)
                 (block (ccl_lx_tok x (-> x k_p) (coco_m_new_atom (-> x e) "##") line) (set (-> x i) (+ (-> x i) 2)))
                 (block (ccl_lx_tok x (-> x k_p) (coco_m_new_atom (-> x e) "#") line) (set (-> x i) (+ (-> x i) 1))))
             (return 1))
            ((== c 35) (ccl_lx_hash x line) (return 1))
            ((== c 34) (return (ccl_lx_string x line)))
            ((== c 39) (return (ccl_lx_char x line)))
            ((and (-> x punct) (ccl_lx_digit c)) (ccl_lx_pp_number x line) (return 1))
            ((ccl_lx_digit c) (return (ccl_lx_number x line)))
            ((ccl_lx_alpha c) (ccl_lx_word x line) (return 1))
            (#t (return (ccl_lx_punct x line))))))

  (func ccl_p_lex_native ((coco_engine * e) (size_t g)) (out int)
        (let ((ccl_lx * x . #'(cast (ccl_lx *) (malloc (sizeof ccl_lx))))
              (i64 line0 . 0) (const char * mode . nil) (const char * lang . nil)
              (size_t toks . 0) (size_t rest . 0))
          (if (not (coco_m_is_atom e (coco_m_arg e g 0)))
              (block (free x) (return (coco_m_type_error e "atom" (coco_m_arg e g 0)))))
          (if (not (coco_m_int e (coco_m_arg e g 1) (aof line0)))
              (block (free x) (return (coco_m_type_error e "integer" (coco_m_arg e g 1)))))
          (set (-> x e) e)
          (set (-> x m) (coco_m_machine e))
          (set (-> x s) (coco_m_atom e (coco_m_arg e g 0)))
          (set (-> x n) (strlen (-> x s)))
          (set (-> x i) 0)
          (set (-> x line) line0)
          (set mode (coco_m_atom e (coco_m_arg e g 2)))
          (set (-> x punct) (? (and (!= mode nil) (== 0 (strcmp mode "punct"))) 1 0))
          (set lang (coco_m_atom e (coco_m_arg e g 3)))
          (set (-> x cpp) (? (and (!= lang nil) (== 0 (strcmp lang "cpp"))) 1 0))
          (set (-> x cap) 1024)
          (set (-> x ntoks) 0)
          (set (-> x toks) (cast (size_t *) (malloc (* (-> x cap) (sizeof size_t)))))
          (set (-> x bcap) 256)
          (set (-> x bn) 0)
          (set (-> x buf) (cast (char *) (malloc (-> x bcap))))
          (set (nth 0 (-> x buf)) 0)
          (set (-> x k_id) (coco_m_new_atom e "id"))
          (set (-> x k_kw) (coco_m_new_atom e "kw"))
          (set (-> x k_int) (coco_m_new_atom e "int"))
          (set (-> x k_float) (coco_m_new_atom e "float"))
          (set (-> x k_str) (coco_m_new_atom e "str"))
          (set (-> x k_chr) (coco_m_new_atom e "chr"))
          (set (-> x k_p) (coco_m_new_atom e "p"))
          (set (-> x k_pp) (coco_m_new_atom e "pp"))
          (set (-> x k_cocolog) (coco_m_new_atom e "cocolog"))
          (set (-> x k_num) (coco_m_new_atom e "num"))
          (ccl_lx_layout x)
          (while (< (-> x i) (-> x n))
            (if (not (ccl_lx_token x)) break)
            (ccl_lx_layout x))
          (set toks (coco_m_list e (-> x toks) (-> x ntoks)))
          (set rest (ccl_lx_codes x (+ (-> x s) (-> x i)) (- (-> x n) (-> x i))))
          (free (-> x toks))
          (free (-> x buf))
          (free x)
          (if (not (coco_m_unify e (coco_m_arg e g 4) toks)) (return 0))
          (return (coco_m_unify e (coco_m_arg e g 5) rest))))

  ;; ccl_host_arch(-Arch): the architecture this module was compiled on,
  ;; arm64 or x86_64 -- the preprocessor's predefined macros and the
  ;; lowering's ABI ask it, so no process spawns `uname -m' (0.14 s a spawn)
  (func ccl_p_host_arch ((coco_engine * e) (size_t g)) (out int)
        (@ifdef (code "__aarch64__"))
        (return (coco_m_unify_atom e (coco_m_arg e g 0) "arm64"))
        (@else)
        (return (coco_m_unify_atom e (coco_m_arg e g 0) "x86_64"))
        (@endif))

  (static) (coco-emit-module-dispatch ccl_dispatch *ccl-predicates*)
  (coco-deflibrary "cicili" ccl_dispatch *ccl-prolog*))
