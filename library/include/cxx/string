/* cicili-lang's <string>: std::string as Safe Modern C++ has it -- an own
   buffer, always terminated, grown by doubling, freed by the destructor;
   built from a C string, appended a char or a C string or a string, indexed
   by reference, compared with a C string or a string, read through c_str().
   The compiler's own, found ahead of libc++'s; its template-free class is
   read from the header's summary like any class. A string is never copied:
   two owners of one buffer would free it twice, so the compiler refuses a
   copy of a class with a destructor -- hand a string by reference or by
   pointer, and return one made in the function (a temporary). */
#ifndef CICILI_STRING
#define CICILI_STRING
extern "C" {
    void *realloc(void *p, unsigned long size);
    void free(void *p);
    unsigned long strlen(const char *s);
    void *memcpy(void *d, const void *s, unsigned long n);
    int strcmp(const char *a, const char *b);
}
namespace std {
class string {
    own char *d;
    int n;
    int cap;
    void grow(int need) {
        if (need + 1 > cap) {
            int c = cap ? cap : 16;
            while (c < need + 1) c = c * 2;
            cap = c;
            d = (own char *) realloc(d, cap);
        }
    }
public:
    string() : d(nullptr), n(0), cap(0) { grow(0); d[0] = 0; }
    string(const char *s) : d(nullptr), n(0), cap(0) { int m = (int) strlen(s); grow(m); memcpy(d, s, m + 1); n = m; }
    ~string() { free(d); }
    int size() const { return n; }
    int length() const { return n; }
    bool empty() const { return n == 0; }
    const char *c_str() const { return d; }
    char &operator[](int i) { return d[i]; }
    void clear() { n = 0; d[0] = 0; }
    string &operator+=(char c) { grow(n + 1); d[n] = c; n = n + 1; d[n] = 0; return *this; }
    string &operator+=(const char *s) { int m = (int) strlen(s); grow(n + m); memcpy(d + n, s, m + 1); n = n + m; return *this; }
    string &operator+=(const string &o) { grow(n + o.n); memcpy(d + n, o.d, o.n + 1); n = n + o.n; return *this; }
    bool operator==(const char *s) const { return strcmp(d, s) == 0; }
    bool operator==(const string &o) const { return strcmp(d, o.d) == 0; }
    bool operator!=(const char *s) const { return strcmp(d, s) != 0; }
};
}
#endif
